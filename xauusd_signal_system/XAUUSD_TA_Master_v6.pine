// © 2026 XAUUSD TA Master v6.1 — Confluence Scanner + SMC
// Новая система с нуля, построена строго по 12 блокам обучения трейдингу,
// плюс SMC-концепции (ложные пробои/ликвидность, imbalance, слом структуры):
//   Блок 1  — Японские свечи (тело/тени)                -> body/upperShadow/lowerShadow
//   Блок 2  — Таймфреймы сверху вниз                     -> H4 (макро) -> H1 (структура/уровни) -> вход TF
//   Блок 3  — Тренды (вверх/вниз/боковик)                -> trendState
//   Блок 4  — Уровни поддержки/сопротивления              -> pivot H1, ближайший уровень
//   Блок 5  — Пробой и ретест + Liquidity Sweep           -> state-machine breakout->retest,
//                                                             sweep уровня тенью с закрытием обратно (ложный пробой)
//   Блок 6  — Объём                                       -> volOK (бонус к уверенности)
//   Блок 7  — EMA200 H4+H1                                -> часть тренда (Блок 3)
//   Блок 8  — Свечные паттерны (пинбар/поглощение/доджи)  -> обязательное подтверждение входа
//   Блок 9  — Графические фигуры + SMC                    -> двойная вершина/дно (вето),
//                                                             FVG/imbalance (бонус), CHoCH (вето при сломе структуры)
//   Блок 10 — Точка входа + SL + TP (ATR-based)           -> entry/sl/tp
//
// Логика входа = ОДНА связная идея сделки, а не 5 случайных совпадений:
//   тренд согласован  AND  триггер (пробой+ретест ИЛИ liquidity sweep/отбой от уровня по тренду)
//   AND свечное подтверждение  AND  нет противоположной фигуры (дв.вершина/дно)  AND  нет CHoCH против сделки
//   Объём и FVG — бонус к оценке уверенности, не жёсткое условие.
//
// Алерт шлёт JSON в message — используется внешним Python-сервисом
// (webhook_relay.py), который прогоняет сетап через Claude как доп.фильтр
// и пересылает подтверждённые сигналы в Telegram. Сама индикация на графике
// (стрелки/таблица/TP-SL линии) работает и без вебхука, на бесплатном плане.
//@version=6
indicator("XAUUSD TA Master v6.1 (Confluence + SMC)", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
// ВХОДНЫЕ ПАРАМЕТРЫ
// ═══════════════════════════════════════════════════════════════════

grp_trend = "═══ БЛОК 3+7: ТРЕНД (EMA200 H4/H1) ═══"
inpEMAperiod    = input.int(200, "EMA период (H4/H1)", minval=50, group=grp_trend)
inpFlatATRmult  = input.float(0.6, "Порог 'боковика' (× ATR)", minval=0.1, step=0.1, group=grp_trend, tooltip="Если |EMA H4 - EMA H1| меньше ATR×это значение — рынок считается боковиком")

grp_sr = "═══ БЛОК 4: S/R УРОВНИ (pivot H1) ═══"
inpSRPivotLR    = input.int(3, "Плечо pivot на H1 (баров)", minval=1, maxval=10, group=grp_sr)
inpSRMaxLevels  = input.int(15, "Кол-во хранимых уровней", minval=5, maxval=40, group=grp_sr)
inpSRZonePts    = input.int(300, "Зона реакции возле уровня (pts)", minval=50, group=grp_sr)

grp_bo = "═══ БЛОК 5: ПРОБОЙ + РЕТЕСТ ═══"
inpBreakoutBufPts = input.int(150, "Мин. пробой за уровень (pts)", minval=50, group=grp_bo, tooltip="Насколько цена должна закрыться за уровнем, чтобы это считалось пробоем, а не шумом")
inpRetestMinBars  = input.int(2, "Мин. баров до ретеста", minval=1, maxval=10, group=grp_bo)
inpRetestMaxBars  = input.int(20, "Макс. баров ожидания ретеста", minval=5, maxval=60, group=grp_bo)

grp_vol = "═══ БЛОК 6: ОБЪЁМ (бонус) ═══"
inpVolPeriod    = input.int(20, "Баров для среднего объёма", minval=5, group=grp_vol)
inpVolMult      = input.float(1.3, "Множитель объёма", minval=1.0, step=0.1, group=grp_vol)

grp_candle = "═══ БЛОК 1+8: СВЕЧНЫЕ ПАТТЕРНЫ ═══"
inpPinBarRatio  = input.float(2.0, "Pin Bar тень/тело", minval=1.5, group=grp_candle)
inpDojiMaxBody  = input.float(0.1, "Doji: тело ≤ X × диапазон", minval=0.02, step=0.01, group=grp_candle)

grp_pattern = "═══ БЛОК 9: ГРАФИЧЕСКИЕ ФИГУРЫ + SMC ═══"
inpPatternTolPts = input.int(250, "Допуск равенства вершин/дна (pts)", minval=50, group=grp_pattern)
inpFVGLookback   = input.int(30, "Баров назад для поиска FVG", minval=5, maxval=100, group=grp_pattern, tooltip="Imbalance / Fair Value Gap — бонус к уверенности")

grp_entry = "═══ БЛОК 10: ВХОД / SL / TP ═══"
inpUseATR       = input.bool(true, "SL/TP по ATR (рекомендую)", group=grp_entry)
inpATRPeriod    = input.int(14, "Период ATR", minval=5, group=grp_entry)
inpATR_SLmult   = input.float(1.5, "SL = ATR ×", minval=0.5, step=0.1, group=grp_entry)
inpRR           = input.float(2.0, "TP = SL × R:R", minval=1.0, step=0.1, group=grp_entry)
inpSL_pts       = input.int(500, "SL фикс. (pts, если ATR выкл.)", minval=100, group=grp_entry)
inpTP_pts       = input.int(1000, "TP фикс. (pts, если ATR выкл.)", minval=100, group=grp_entry)
inpMinBonus     = input.int(0, "Мин. бонус-очков (объём/двойное дно-вершина/FVG)", minval=0, maxval=3, group=grp_entry, tooltip="0 = входить сразу по ядру сетапа, 1-3 = требовать доп.подтверждения")
inpShowTPSL     = input.bool(true, "Показывать линии TP/SL", group=grp_entry)
inpTPSLdur      = input.int(20, "Длина линий (баров)", minval=5, maxval=50, group=grp_entry)
inpMaxSignals   = input.int(5, "Макс сигналов на графике", minval=1, maxval=20, group=grp_entry)

grp_cool = "═══ АНТИСПАМ ═══"
inpCooldownBars = input.int(6, "Промежуток между сигналами (баров)", minval=1, maxval=30, group=grp_cool)

grp_disp = "═══ ОТОБРАЖЕНИЕ ═══"
inpShowTable    = input.bool(true, "Показывать таблицу", group=grp_disp)
inpTablePos     = input.string("top_left", "Позиция таблицы", options=["top_left","top_right","bottom_left","bottom_right"], group=grp_disp)
inpShowArrows   = input.bool(true, "Показывать стрелки", group=grp_disp)

grp_alert = "═══ АЛЕРТ / ИНТЕГРАЦИЯ ═══"
inpWebhookSecret = input.string("REPLACE_ME", "Секрет вебхука", group=grp_alert, tooltip="Должен совпадать с WEBHOOK_SECRET в webhook_relay.py")

// ═══════════════════════════════════════════════════════════════════
// БЛОК 1: СВЕЧА (текущий TF, обычно M15) — тело/тени
// ═══════════════════════════════════════════════════════════════════

candleBull  = close > open
candleBear  = close < open
body        = math.abs(close - open)
rng         = high - low
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low

prevOpen  = open[1]
prevClose = close[1]
prevBody  = math.abs(prevClose - prevOpen)

// ═══════════════════════════════════════════════════════════════════
// БЛОК 2+3+7: ТАЙМФРЕЙМЫ СВЕРХУ ВНИЗ + ТРЕНД (EMA200 H4/H1, без репейнта)
// ═══════════════════════════════════════════════════════════════════

emaH4 = request.security(syminfo.tickerid, "240", ta.ema(close, inpEMAperiod)[1], lookahead=barmerge.lookahead_off)
emaH1 = request.security(syminfo.tickerid, "60", ta.ema(close, inpEMAperiod)[1], lookahead=barmerge.lookahead_off)
atr14 = ta.atr(inpATRPeriod)

emaSpreadFlat = math.abs(emaH4 - emaH1) < atr14 * inpFlatATRmult

// trendState: 1 = восходящий, -1 = нисходящий, 0 = боковик/смешанный
trendState = emaSpreadFlat ? 0 : (close > emaH4 and close > emaH1 ? 1 : close < emaH4 and close < emaH1 ? -1 : 0)
trendUp    = trendState == 1
trendDown  = trendState == -1

// ═══════════════════════════════════════════════════════════════════
// БЛОК 4: S/R УРОВНИ — реальные pivot high/low на H1 (не скользящий экстремум)
// ═══════════════════════════════════════════════════════════════════

h1PivHighRaw = request.security(syminfo.tickerid, "60", ta.pivothigh(high, inpSRPivotLR, inpSRPivotLR), lookahead=barmerge.lookahead_off)
h1PivLowRaw  = request.security(syminfo.tickerid, "60", ta.pivotlow(low, inpSRPivotLR, inpSRPivotLR), lookahead=barmerge.lookahead_off)

var array<float> pivotHighs = array.new<float>()
var array<float> pivotLows  = array.new<float>()
var float lastPivHighPushed = na
var float lastPivLowPushed  = na

if not na(h1PivHighRaw) and h1PivHighRaw != lastPivHighPushed
    array.push(pivotHighs, h1PivHighRaw)
    lastPivHighPushed := h1PivHighRaw
    if array.size(pivotHighs) > inpSRMaxLevels
        array.shift(pivotHighs)

if not na(h1PivLowRaw) and h1PivLowRaw != lastPivLowPushed
    array.push(pivotLows, h1PivLowRaw)
    lastPivLowPushed := h1PivLowRaw
    if array.size(pivotLows) > inpSRMaxLevels
        array.shift(pivotLows)

nearestAbove(arr, price) =>
    float result = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > price and (na(result) or v < result)
                result := v
    result

nearestBelow(arr, price) =>
    float result = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < price and (na(result) or v > result)
                result := v
    result

nearestResistance = nearestAbove(pivotHighs, close)
nearestSupport    = nearestBelow(pivotLows, close)

priceAtResistance = not na(nearestResistance) and close <= nearestResistance and (nearestResistance - close) / syminfo.mintick <= inpSRZonePts
priceAtSupport    = not na(nearestSupport) and close >= nearestSupport and (close - nearestSupport) / syminfo.mintick <= inpSRZonePts

// ═══════════════════════════════════════════════════════════════════
// БЛОК 5: ПРОБОЙ + РЕТЕСТ (state machine, обновляется только на закрытом баре)
// ═══════════════════════════════════════════════════════════════════

var float pendingLevel       = na
var int   pendingDir         = 0   // 1 = пробили сопротивление вверх, -1 = пробили поддержку вниз
var int   pendingBreakoutBar = na

brokeResUp   = not na(nearestResistance) and close > nearestResistance + inpBreakoutBufPts * syminfo.mintick
brokeSupDown = not na(nearestSupport) and close < nearestSupport - inpBreakoutBufPts * syminfo.mintick

retestLongTrigger  = false
retestShortTrigger = false

if barstate.isconfirmed
    barsSincePending = pendingDir != 0 ? bar_index - pendingBreakoutBar : na

    // Ретест: цена вернулась к пробитому уровню и удержала его повторным закрытием в сторону пробоя
    if pendingDir == 1 and not na(barsSincePending) and barsSincePending >= inpRetestMinBars and barsSincePending <= inpRetestMaxBars
        if close >= pendingLevel and (close - pendingLevel) / syminfo.mintick <= inpSRZonePts and candleBull
            retestLongTrigger := true
    if pendingDir == -1 and not na(barsSincePending) and barsSincePending >= inpRetestMinBars and barsSincePending <= inpRetestMaxBars
        if close <= pendingLevel and (pendingLevel - close) / syminfo.mintick <= inpSRZonePts and candleBear
            retestShortTrigger := true

    // Инвалидация: пробой не подтвердился, цена ушла обратно
    if pendingDir == 1 and close < pendingLevel - inpBreakoutBufPts * syminfo.mintick
        pendingDir := 0
    if pendingDir == -1 and close > pendingLevel + inpBreakoutBufPts * syminfo.mintick
        pendingDir := 0

    // Истечение окна ожидания ретеста
    if pendingDir != 0 and not na(barsSincePending) and barsSincePending > inpRetestMaxBars
        pendingDir := 0

    // Срабатывание ретеста — гасим ожидание
    if retestLongTrigger or retestShortTrigger
        pendingDir := 0

    // Новый пробой запускает новое ожидание ретеста
    if brokeResUp
        pendingLevel := nearestResistance
        pendingDir := 1
        pendingBreakoutBar := bar_index
    if brokeSupDown
        pendingLevel := nearestSupport
        pendingDir := -1
        pendingBreakoutBar := bar_index

// Liquidity sweep (SMC, "ложный пробой"/стоп-хант): цена протыкает уровень
// тенью (собирает стопы/ликвидность за ним), но ЗАКРЫВАЕТСЯ обратно за
// уровнем — признак ложного пробоя и разворота в сторону тренда, сильнее
// простого "цена рядом с уровнем", поэтому приоритетнее.
sweptSupport    = not na(nearestSupport) and low < nearestSupport and close > nearestSupport
sweptResistance = not na(nearestResistance) and high > nearestResistance and close < nearestResistance

liquiditySweepLong  = trendUp and sweptSupport and candleBull
liquiditySweepShort = trendDown and sweptResistance and candleBear

// Второй тип триггера — отбой от уровня ПО ТРЕНДУ (покупка от поддержки в аптренде и т.п.)
bounceLongTrigger  = liquiditySweepLong or (trendUp and priceAtSupport and candleBull)
bounceShortTrigger = liquiditySweepShort or (trendDown and priceAtResistance and candleBear)

setupLongTrigger  = retestLongTrigger or bounceLongTrigger
setupShortTrigger = retestShortTrigger or bounceShortTrigger

setupLongType  = retestLongTrigger ? "Пробой+Ретест" : liquiditySweepLong ? "Liquidity Sweep" : bounceLongTrigger ? "Отбой от S/R" : "нет"
setupShortType = retestShortTrigger ? "Пробой+Ретест" : liquiditySweepShort ? "Liquidity Sweep" : bounceShortTrigger ? "Отбой от S/R" : "нет"

// ═══════════════════════════════════════════════════════════════════
// БЛОК 8: СВЕЧНЫЕ ПАТТЕРНЫ — Pin Bar / Engulfing / Doji
// ═══════════════════════════════════════════════════════════════════

bullishPinBar     = lowerShadow >= body * inpPinBarRatio and upperShadow <= body * 0.5 and body > 0
bearishPinBar     = upperShadow >= body * inpPinBarRatio and lowerShadow <= body * 0.5 and body > 0
bullishEngulfing  = prevClose < prevOpen and candleBull and close > prevOpen and open < prevClose and body > prevBody * 1.1
bearishEngulfing  = prevClose > prevOpen and candleBear and close < prevOpen and open > prevClose and body > prevBody * 1.1
isDoji            = rng > 0 and body <= rng * inpDojiMaxBody

candleDir = bullishPinBar or bullishEngulfing ? 1 : bearishPinBar or bearishEngulfing ? -1 : 0
candlePatternName = bullishPinBar ? "Bull Pin Bar" : bearishPinBar ? "Bear Pin Bar" : bullishEngulfing ? "Bull Engulfing" : bearishEngulfing ? "Bear Engulfing" : isDoji ? "Doji (неопр.)" : "нет"

// ═══════════════════════════════════════════════════════════════════
// БЛОК 6: ОБЪЁМ (бонус к уверенности, не жёсткий гейт)
// ═══════════════════════════════════════════════════════════════════

avgVol   = ta.sma(volume, inpVolPeriod)
volRatio = avgVol > 0 ? volume / avgVol : 0.0
volOK    = volRatio >= inpVolMult

// ═══════════════════════════════════════════════════════════════════
// БЛОК 9: ГРАФИЧЕСКИЕ ФИГУРЫ — двойная вершина/дно (вето), треугольник (инфо)
// ═══════════════════════════════════════════════════════════════════

doubleTopActive = false
doubleBottomActive = false
if array.size(pivotHighs) >= 2
    h1 = array.get(pivotHighs, array.size(pivotHighs) - 1)
    h2 = array.get(pivotHighs, array.size(pivotHighs) - 2)
    if math.abs(h1 - h2) / syminfo.mintick <= inpPatternTolPts and not na(nearestSupport) and close < nearestSupport
        doubleTopActive := true
if array.size(pivotLows) >= 2
    l1 = array.get(pivotLows, array.size(pivotLows) - 1)
    l2 = array.get(pivotLows, array.size(pivotLows) - 2)
    if math.abs(l1 - l2) / syminfo.mintick <= inpPatternTolPts and not na(nearestResistance) and close > nearestResistance
        doubleBottomActive := true

rangeNow  = ta.highest(high, 20) - ta.lowest(low, 20)
rangePrev = ta.highest(high, 20)[20] - ta.lowest(low, 20)[20]
triangleSqueeze = rangePrev > 0 and rangeNow < rangePrev * 0.7

// Imbalance / Fair Value Gap — 3-свечная модель непокрытого гэпа. Бонус к
// уверенности, если цена сейчас внутри недавней непокрытой зоны.
bool inBullFVG = false
bool inBearFVG = false
for k = 0 to inpFVGLookback - 1
    aHigh = high[k + 2]
    aLow  = low[k + 2]
    cHigh = high[k]
    cLow  = low[k]
    if cLow > aHigh and close >= aHigh and close <= cLow
        inBullFVG := true
    if cHigh < aLow and close <= aLow and close >= cHigh
        inBearFVG := true

// CHoCH (Change of Character) — слом структуры тренда на H1: структура
// делала растущие лои (HL), но цена только что пробила последний лой вниз
// (bearishChoch) — или зеркально для bullishChoch. Ранний сигнал разворота,
// который EMA200 ещё не подтвердила.
bearishChoch = array.size(pivotLows) >= 2 and array.get(pivotLows, array.size(pivotLows) - 1) > array.get(pivotLows, array.size(pivotLows) - 2) and close < array.get(pivotLows, array.size(pivotLows) - 1)
bullishChoch = array.size(pivotHighs) >= 2 and array.get(pivotHighs, array.size(pivotHighs) - 1) < array.get(pivotHighs, array.size(pivotHighs) - 2) and close > array.get(pivotHighs, array.size(pivotHighs) - 1)

chartPatternNote = doubleTopActive ? "⚠ Дв.вершина" : doubleBottomActive ? "⚠ Дв.дно" : bearishChoch ? "⚠ CHoCH↓" : bullishChoch ? "⚠ CHoCH↑" : inBullFVG or inBearFVG ? "FVG" : triangleSqueeze ? "Сжатие/треугольник" : "нет"

// ═══════════════════════════════════════════════════════════════════
// СБОРКА СЕТАПА — ядро (обязательное) + бонусы (доп.уверенность)
// ═══════════════════════════════════════════════════════════════════

coreLong  = trendUp   and setupLongTrigger  and candleDir == 1
coreShort = trendDown and setupShortTrigger and candleDir == -1

bonusLong  = (volOK ? 1 : 0) + (doubleBottomActive ? 1 : 0) + (inBullFVG ? 1 : 0)
bonusShort = (volOK ? 1 : 0) + (doubleTopActive ? 1 : 0) + (inBearFVG ? 1 : 0)

vetoLong  = doubleTopActive or bearishChoch
vetoShort = doubleBottomActive or bullishChoch

longSetupOK  = coreLong  and not vetoLong  and bonusLong  >= inpMinBonus
shortSetupOK = coreShort and not vetoShort and bonusShort >= inpMinBonus

// ═══════════════════════════════════════════════════════════════════
// СИГНАЛЫ (антиспам + строго на закрытом баре)
// ═══════════════════════════════════════════════════════════════════

var int lastLongBar  = -100
var int lastShortBar = -100

barsSinceLong  = bar_index - lastLongBar
barsSinceShort = bar_index - lastShortBar

longSignal  = longSetupOK  and barsSinceLong  >= inpCooldownBars and barstate.isconfirmed
shortSignal = shortSetupOK and barsSinceShort >= inpCooldownBars and barstate.isconfirmed
anySignal   = longSignal or shortSignal

if longSignal
    lastLongBar := bar_index
if shortSignal
    lastShortBar := bar_index

// ═══════════════════════════════════════════════════════════════════
// БЛОК 10: ВХОД / SL / TP
// ═══════════════════════════════════════════════════════════════════

slDist = inpUseATR ? atr14 * inpATR_SLmult : inpSL_pts * syminfo.mintick
tpDist = inpUseATR ? slDist * inpRR : inpTP_pts * syminfo.mintick

var string lastSignalType  = "нет"
var float  lastSignalPrice = na
var float  lastSignalTP    = na
var float  lastSignalSL    = na
var string lastSignalSetup = ""
var int    lastSignalTime  = 0

var int totalSignalsToday = 0
var int lastSignalDay     = 0

if dayofmonth != lastSignalDay
    totalSignalsToday := 0
    lastSignalDay := dayofmonth

if anySignal
    totalSignalsToday += 1

if longSignal
    lastSignalType  := "LONG"
    lastSignalPrice := close
    lastSignalTP    := close + tpDist
    lastSignalSL    := close - slDist
    lastSignalSetup := setupLongType
    lastSignalTime  := time

if shortSignal
    lastSignalType  := "SHORT"
    lastSignalPrice := close
    lastSignalTP    := close - tpDist
    lastSignalSL    := close + slDist
    lastSignalSetup := setupShortType
    lastSignalTime  := time

// ═══════════════════════════════════════════════════════════════════
// СТРЕЛКИ + ЛИНИИ TP/SL
// ═══════════════════════════════════════════════════════════════════

if inpShowArrows and longSignal
    label.new(bar_index, low, text="▲ LONG (" + setupLongType + ")\n" + str.tostring(close, "#.##"), style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)

if inpShowArrows and shortSignal
    label.new(bar_index, high, text="▼ SHORT (" + setupShortType + ")\n" + str.tostring(close, "#.##"), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)

var array<line> arrEntry = array.new<line>()
var array<line> arrTP    = array.new<line>()
var array<line> arrSL    = array.new<line>()
var array<label> arrLblTP = array.new<label>()
var array<label> arrLblSL = array.new<label>()

removeOldest() =>
    if array.size(arrEntry) >= inpMaxSignals
        line.delete(array.shift(arrEntry))
        line.delete(array.shift(arrTP))
        line.delete(array.shift(arrSL))
        label.delete(array.shift(arrLblTP))
        label.delete(array.shift(arrLblSL))

if inpShowTPSL and anySignal
    entryPrice = close
    endBar = bar_index + inpTPSLdur

    removeOldest()

    entryLine = line.new(bar_index, entryPrice, endBar, entryPrice, color=color.yellow, width=2, style=line.style_solid)
    array.push(arrEntry, entryLine)

    tpLine = line.new(bar_index, lastSignalTP, endBar, lastSignalTP, color=color.new(color.lime, 20), width=2, style=line.style_dashed)
    array.push(arrTP, tpLine)

    slLine = line.new(bar_index, lastSignalSL, endBar, lastSignalSL, color=color.new(color.red, 20), width=2, style=line.style_dashed)
    array.push(arrSL, slLine)

    tpLabel = label.new(endBar, lastSignalTP, text="TP " + str.tostring(lastSignalTP, "#.##"), style=label.style_label_left, color=color.new(color.lime, 20), textcolor=color.white, size=size.tiny)
    array.push(arrLblTP, tpLabel)

    slLabel = label.new(endBar, lastSignalSL, text="SL " + str.tostring(lastSignalSL, "#.##"), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
    array.push(arrLblSL, slLabel)

// ═══════════════════════════════════════════════════════════════════
// ТАБЛИЦА
// ═══════════════════════════════════════════════════════════════════

tablePos = inpTablePos == "top_left" ? position.top_left : inpTablePos == "top_right" ? position.top_right : inpTablePos == "bottom_left" ? position.bottom_left : position.bottom_right
var table t = table.new(tablePos, 2, 18, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if inpShowTable and barstate.islast
    table.clear(t, 0, 0, 1, 17)

    table.cell(t, 0, 0, "═══ XAUUSD TA v6.1 ═══", text_color=color.aqua, text_size=size.normal)
    table.merge_cells(t, 0, 0, 1, 0)

    table.cell(t, 0, 1, "Цена:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(close, "#.##"), text_color=color.white, text_size=size.small)

    trendText = trendUp ? "✅ ВВЕРХ" : trendDown ? "✅ ВНИЗ" : "❌ БОКОВИК"
    trendColor = trendUp ? color.lime : trendDown ? color.red : color.gray
    table.cell(t, 0, 2, "Блок3: Тренд:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 2, trendText, text_color=trendColor, text_size=size.small)

    table.cell(t, 0, 3, "Блок4: Сопр./Подд.:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 3, (na(nearestResistance) ? "-" : str.tostring(nearestResistance, "#.##")) + " / " + (na(nearestSupport) ? "-" : str.tostring(nearestSupport, "#.##")), text_color=color.white, text_size=size.small)

    pendingText = pendingDir == 1 ? "⏳ ждём ретест верх" : pendingDir == -1 ? "⏳ ждём ретест вниз" : "нет"
    table.cell(t, 0, 4, "Блок5: Пробой:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 4, pendingText, text_color=color.yellow, text_size=size.small)

    volText = volOK ? "✅ " + str.tostring(volRatio, "#.#") + "x" : "❌ " + str.tostring(volRatio, "#.#") + "x"
    table.cell(t, 0, 5, "Блок6: Объём:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 5, volText, text_color=volOK ? color.lime : color.gray, text_size=size.small)

    candleColor = candleDir == 1 ? color.lime : candleDir == -1 ? color.red : color.gray
    table.cell(t, 0, 6, "Блок8: Свеча:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 6, candlePatternName, text_color=candleColor, text_size=size.small)

    table.cell(t, 0, 7, "Блок9: Фигура:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 7, chartPatternNote, text_color=(doubleTopActive or doubleBottomActive) ? color.orange : color.gray, text_size=size.small)

    table.cell(t, 0, 8, "─── СЕТАП ───", text_color=color.yellow, text_size=size.small)
    table.merge_cells(t, 0, 8, 1, 8)

    table.cell(t, 0, 9, "📈 LONG готов:", text_color=color.lime, text_size=size.small)
    table.cell(t, 1, 9, longSetupOK ? "✅ " + setupLongType : "—", text_color=longSetupOK ? color.lime : color.silver, text_size=size.small)

    table.cell(t, 0, 10, "📉 SHORT готов:", text_color=color.red, text_size=size.small)
    table.cell(t, 1, 10, shortSetupOK ? "✅ " + setupShortType : "—", text_color=shortSetupOK ? color.lime : color.silver, text_size=size.small)

    table.cell(t, 0, 11, "─── ПОСЛЕДНИЙ ───", text_color=color.yellow, text_size=size.small)
    table.merge_cells(t, 0, 11, 1, 11)

    table.cell(t, 0, 12, "Тип:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 12, lastSignalType + (lastSignalSetup != "" ? " (" + lastSignalSetup + ")" : ""), text_color=lastSignalType == "LONG" ? color.lime : lastSignalType == "SHORT" ? color.red : color.white, text_size=size.small)

    if not na(lastSignalPrice)
        table.cell(t, 0, 13, "Вход:", text_color=color.silver, text_size=size.small)
        table.cell(t, 1, 13, str.tostring(lastSignalPrice, "#.##"), text_color=color.yellow, text_size=size.small)
        table.cell(t, 0, 14, "TP / SL:", text_color=color.silver, text_size=size.small)
        table.cell(t, 1, 14, str.tostring(lastSignalTP, "#.##") + " / " + str.tostring(lastSignalSL, "#.##"), text_color=color.white, text_size=size.small)
        table.cell(t, 0, 15, "Время:", text_color=color.silver, text_size=size.small)
        table.cell(t, 1, 15, str.format_time(lastSignalTime, "HH:mm dd.MM"), text_color=color.white, text_size=size.small)

    table.cell(t, 0, 16, "Сегодня сигналов:", text_color=color.silver, text_size=size.small)
    table.cell(t, 1, 16, str.tostring(totalSignalsToday), text_color=color.white, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════
// АЛЕРТЫ — JSON для webhook_relay.py (Claude confirm -> Telegram)
// ═══════════════════════════════════════════════════════════════════

if longSignal
    msgLong = '{"secret":"' + inpWebhookSecret + '","symbol":"' + syminfo.ticker + '","dir":"LONG","setup":"' + setupLongType + '","entry":' + str.tostring(close) + ',"sl":' + str.tostring(lastSignalSL) + ',"tp":' + str.tostring(lastSignalTP) + ',"trend":"UP","volRatio":' + str.tostring(volRatio, "#.##") + ',"volOK":' + (volOK ? "true" : "false") + ',"pattern":"' + chartPatternNote + '","bonus":' + str.tostring(bonusLong) + '}'
    alert(msgLong, alert.freq_once_per_bar_close)

if shortSignal
    msgShort = '{"secret":"' + inpWebhookSecret + '","symbol":"' + syminfo.ticker + '","dir":"SHORT","setup":"' + setupShortType + '","entry":' + str.tostring(close) + ',"sl":' + str.tostring(lastSignalSL) + ',"tp":' + str.tostring(lastSignalTP) + ',"trend":"DOWN","volRatio":' + str.tostring(volRatio, "#.##") + ',"volOK":' + (volOK ? "true" : "false") + ',"pattern":"' + chartPatternNote + '","bonus":' + str.tostring(bonusShort) + '}'
    alert(msgShort, alert.freq_once_per_bar_close)

// Скрытые plot для удобства построения condition-алертов вручную при желании
plot(longSetupOK ? 1 : 0, "LongSetupOK", color=color.new(color.lime, 100), display=display.none)
plot(shortSetupOK ? 1 : 0, "ShortSetupOK", color=color.new(color.red, 100), display=display.none)
