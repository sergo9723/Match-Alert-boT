# Скопируйте в .env и заполните своими значениями. Файл .env в git не коммитить.

# Токен Telegram-бота от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# chat_id куда слать сигналы (свой личный chat_id или id группы/канала)
TELEGRAM_CHAT_ID=

# Ключ Anthropic API (platform.anthropic.com)
ANTHROPIC_API_KEY=

# Должен СОВПАДАТЬ со значением "Секрет вебхука" в настройках индикатора в TradingView
WEBHOOK_SECRET=REPLACE_ME

# Модель Claude для проверки сетапов
CLAUDE_MODEL=claude-sonnet-5

# Слать в Telegram даже отклонённые ИИ сигналы (для отладки/статистики)
NOTIFY_ON_REJECT=false

# Порт локального запуска
PORT=5000
