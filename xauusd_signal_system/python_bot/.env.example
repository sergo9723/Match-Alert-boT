# Скопируйте в .env (в той же папке python_bot/) и заполните. .env в git не коммитить.

# Источник котировок: yfinance (без регистрации) или oanda (нужен демо-счёт)
DATA_SOURCE=yfinance

# --- yfinance ---
# GC=F = фьючерс на золото COMEX (надёжнее внутридневные данные на Yahoo).
# Можно попробовать XAUUSD=X (спот), но там чаще встречаются разрывы данных.
YFINANCE_TICKER=GC=F

# --- OANDA (если DATA_SOURCE=oanda) ---
# Бесплатный demo-счёт: https://www.oanda.com/demo-account/tpa/personal_finance
OANDA_API_KEY=
OANDA_INSTRUMENT=XAU_USD
OANDA_ENVIRONMENT=practice

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude (доп.фильтр) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Слать в Telegram даже отклонённые ИИ сигналы (для отладки/статистики)
NOTIFY_ON_REJECT=false

# Как часто опрашивать котировки (секунды). 60 = раз в минуту.
POLL_SECONDS=60

# Название символа в сообщениях
SYMBOL_LABEL=XAUUSD

# Файл журнала всех сигналов (подтверждённых и отклонённых)
SIGNAL_LOG_FILE=signals_log.jsonl
