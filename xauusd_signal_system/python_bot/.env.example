# Скопируйте в .env (в той же папке python_bot/) и заполните. .env в git не коммитить.

# Источник котировок: yahoo (без регистрации) или oanda (нужен демо-счёт)
DATA_SOURCE=yahoo

# --- Инструменты ---
# Список через запятую — бот торгует их ПАРАЛЛЕЛЬНО, каждый со своим
# независимым состоянием (диверсификация вместо ослабления фильтра ради
# частоты сигналов). Доступные: XAUUSD, EURUSD, GBPUSD, USDJPY, AUDUSD,
# USDCAD, NZDUSD, USDCHF, XAGUSD (см. instruments.py).
# ⚠️ Фильтры откалиброваны бэктестом ТОЛЬКО для XAUUSD — прежде чем
# добавлять новую пару, прогоните backtest.py на ЕЁ собственной истории.
INSTRUMENTS=XAUUSD

# --- OANDA (если DATA_SOURCE=oanda) ---
# Бесплатный demo-счёт: https://www.oanda.com/demo-account/tpa/personal_finance
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude (доп.фильтр) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Слать в Telegram даже отклонённые ИИ сигналы (для отладки/статистики)
NOTIFY_ON_REJECT=false

# Как часто опрашивать котировки (секунды). 60 = раз в минуту.
POLL_SECONDS=60

# Файл журнала всех сигналов (подтверждённых и отклонённых)
SIGNAL_LOG_FILE=signals_log.jsonl

# Ниже — переопределение настроек качества фильтра (по умолчанию уже
# стоят лучшие найденные бэктестом на XAUUSD значения: min_bonus=1,
# require_liquidity_sweep=true, RR=2.5, cooldown=3 бара, блокировка входов
# в дни FOMC — см. отчёт в README и main.build_params()). Раскомментируйте,
# только если осознанно хотите проверить другой вариант через backtest.py.
# REQUIRE_LIQUIDITY_SWEEP=false
# MIN_BONUS=0
# RR=2.0
# COOLDOWN_BARS=6

# --- Риск-менеджмент (risk_manager.py) ---
# Баланс счёта в $ — от него считается лот под RISK_PCT% риска на сделку.
# Обновляйте вручную по факту пополнений/выводов (бот не читает баланс
# брокера — сигналы только советуют, сделки открываете вручную в MT5).
ACCOUNT_BALANCE=1000
# Риск на сделку в % от баланса. 1-2% — стандарт, больше — уже агрессивно.
RISK_PCT=1.0
# Максимум подтверждённых сигналов в день (на инструмент) — защита от
# переторговли, даже если фильтр вдруг даст всплеск сетапов.
MAX_TRADES_PER_DAY=3
# Пауза до конца недели, если накопленная просадка достигла -N R
# (закон больших чисел: бэктест показал только 52.5% недель в плюс при
# честном +0.272R/сделку — лимит не делает стратегию прибыльнее, а не
# даёт одной плохой неделе стать катастрофой). "none" — выключить лимит.
WEEKLY_LOSS_LIMIT_R=6
